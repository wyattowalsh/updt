# updt configuration via environment variables
# Copy this file to .env and adjust as needed

# Logging configuration
UPDT_LOG_LEVEL=INFO
UPDT_LOG_FORMAT=jsonl
# UPDT_LOG_FILE=/path/to/logfile.log

# Operation mode
UPDT_DEFAULT_MODE=plan
UPDT_DRY_RUN=false

# Performance settings
UPDT_MAX_CONCURRENT_UPDATES=5
UPDT_TIMEOUT=300

# Ecosystem configuration (true/false)
UPDT_ECOSYSTEMS__BREW=true
UPDT_ECOSYSTEMS__SOFTWAREUPDATE=true
UPDT_ECOSYSTEMS__MAS=true
UPDT_ECOSYSTEMS__UV=true
UPDT_ECOSYSTEMS__PIP=true
UPDT_ECOSYSTEMS__NPM=true
UPDT_ECOSYSTEMS__YARN=true
UPDT_ECOSYSTEMS__PNPM=true
UPDT_ECOSYSTEMS__GEM=true
UPDT_ECOSYSTEMS__BUNDLER=true
UPDT_ECOSYSTEMS__CARGO=true
UPDT_ECOSYSTEMS__POETRY=true
