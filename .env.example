# updtr configuration via environment variables
# Copy this file to .env and adjust as needed

# Logging configuration
UPDTR_LOG_LEVEL=INFO
UPDTR_LOG_FORMAT=jsonl
# UPDTR_LOG_FILE=/path/to/logfile.log

# Operation mode
UPDTR_DEFAULT_MODE=plan
UPDTR_DRY_RUN=false

# Performance settings
UPDTR_MAX_CONCURRENT_UPDATES=5
UPDTR_TIMEOUT=300

# Ecosystem configuration (true/false)

# macOS Ecosystem
UPDTR_ECOSYSTEMS__BREW=true
UPDTR_ECOSYSTEMS__MAS=true

# Python Ecosystem
UPDTR_ECOSYSTEMS__UV=true
UPDTR_ECOSYSTEMS__PIP=true
UPDTR_ECOSYSTEMS__PIPX=true
UPDTR_ECOSYSTEMS__CONDA=true
UPDTR_ECOSYSTEMS__POETRY=true
UPDTR_ECOSYSTEMS__PYENV=true

# Node.js Ecosystem
UPDTR_ECOSYSTEMS__NPM=true
UPDTR_ECOSYSTEMS__YARN=true
UPDTR_ECOSYSTEMS__PNPM=true
UPDTR_ECOSYSTEMS__NVM=true

# Ruby Ecosystem
UPDTR_ECOSYSTEMS__GEM=true
UPDTR_ECOSYSTEMS__BUNDLER=true
UPDTR_ECOSYSTEMS__RVM=true

# Linux Ecosystem
UPDTR_ECOSYSTEMS__APT=true
UPDTR_ECOSYSTEMS__DNF=true
UPDTR_ECOSYSTEMS__FLATPAK=true

# Windows Ecosystem
UPDTR_ECOSYSTEMS__CHOCO=true
UPDTR_ECOSYSTEMS__SCOOP=true
UPDTR_ECOSYSTEMS__WINGET=true

# Other
UPDTR_ECOSYSTEMS__CARGO=true
UPDTR_ECOSYSTEMS__SOFTWAREUPDATE=true
